# Example service config for scripts/serve_up.sh.
#
# Usage:
#   set -a
#   source .env              # should export V_API_KEY (or adjust LLM_API_KEY_ENV below)
#   set +a
#   scripts/serve_up.sh configs/services/vapi.env.example
#
# For a private config, copy this file to configs/services/vapi.env and edit it.

# tmux / runtime
SESSION=robomex
VENV=.venv-libero
LOG_DIR=./logs/servers

# LIBERO / CapX GPU service config
CONFIG=env_configs/libero/franka_libero_cap_agent0.yaml

# Local proxy clients keep using http://localhost:8110/chat/completions.
LLM_PORT=8110

# RECOMMENDED: multi-upstream routing. One proxy serves BOTH OpenRouter and
# V-API at once, routed by model prefix:
#   --model openrouter/qwen/qwen3.6-plus   -> OpenRouter
#   --model vapi/gpt-4o                     -> V-API (GPT / Gemini / ...)
# Keys are resolved by the proxy from .env / key files (see the routes file).
LLM_ROUTES_FILE=configs/services/llm_routes.json

LLM_TIMEOUT_S=600

# --- Legacy single-upstream mode (only used when LLM_ROUTES_FILE is empty) ---
# LLM_BASE_URL=https://api.gpt.ge/v1/
# LLM_API_KEY_ENV=V_API_KEY
# LLM_REASONING_EFFORT=none
